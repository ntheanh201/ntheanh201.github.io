---
import { formatDate, postURL, readingMinutes, tagSlug, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
  showTags?: boolean;
}

const { posts, showTags = true } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <div>
          <a class="title" href={postURL(post.id)}>
            {post.data.title}
          </a>
          <div class="sub">
            <span>{readingMinutes(post.body)} min read</span>
            {showTags && post.data.tags.length > 0 && (
              <span class="tags">
                {post.data.tags.map((t) => (
                  <a class="tag" href={`/tag/${tagSlug(t)}.html`}>
                    {t}
                  </a>
                ))}
              </span>
            )}
          </div>
        </div>
      </li>
    ))
  }
</ul>
