---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getPosts, postURL, readingMinutes, tagSlug } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const pages = await getCollection("pages");
  return [
    ...posts.map((entry, i) => ({
      params: { slug: entry.id },
      props: { entry, kind: "post" as const, newer: posts[i - 1], older: posts[i + 1] },
    })),
    ...pages.map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: "page" as const } })),
  ];
}

const { entry, kind, newer, older } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth <= 3);
const showToc = kind === "post" && toc.length >= 3;
const post = kind === "post" ? (entry as Extract<typeof entry, { collection: "posts" }>) : null;
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  image={post?.data.cover}
  type={post ? "article" : "website"}
>
  <div class:list={["article", { "has-toc": showToc }]}>
    <article>
      <header class="article-head">
        <h1>{entry.data.title}</h1>
        {
          post && (
            <p class="meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span aria-hidden="true"> · </span>
              {readingMinutes(post.body)} min read
              {post.data.tags.length > 0 && (
                <>
                  <span aria-hidden="true"> · </span>
                  <span class="tags">
                    {post.data.tags.map((t) => (
                      <a class="tag" href={`/tag/${tagSlug(t)}.html`}>
                        {t}
                      </a>
                    ))}
                  </span>
                </>
              )}
            </p>
          )
        }
      </header>

      {post?.data.cover && <img class="cover" src={post.data.cover} alt="" loading="eager" />}

      <div class="prose">
        <Content />
      </div>

      {
        post && (newer || older) && (
          <nav class="pager" aria-label="More posts">
            {older ? (
              <a href={postURL(older.id)}>
                <span class="meta">← Older</span>
                {older.data.title}
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a class="next" href={postURL(newer.id)}>
                <span class="meta">Newer →</span>
                {newer.data.title}
              </a>
            )}
          </nav>
        )
      }
    </article>

    {
      showToc && (
        <aside class="toc" aria-label="On this page">
          <p class="eyebrow">On this page</p>
          <ol>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )
    }
  </div>
</Base>

<script is:inline>
  for (const pre of document.querySelectorAll(".prose pre")) {
    const wrap = document.createElement("div");
    wrap.className = "code-block";
    pre.replaceWith(wrap);
    wrap.append(pre);
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy-btn";
    btn.textContent = "Copy";
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = "Copied";
        btn.dataset.copied = "";
      } catch {
        btn.textContent = "Press ⌘C";
      }
      setTimeout(() => {
        btn.textContent = "Copy";
        delete btn.dataset.copied;
      }, 1600);
    });
    wrap.append(btn);
  }
</script>

<style>
  .article {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 1rem;
  }

  @media (min-width: 72rem) {
    .article.has-toc {
      max-width: calc(var(--measure) + 15rem + 3rem);
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) 15rem;
      gap: 3rem;
    }
  }

  .article-head {
    padding-top: 3.5rem;
    margin-bottom: 2rem;
  }

  .article-head h1 {
    font-size: clamp(1.75rem, 5vw, 2.35rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }

  .article-head .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
  }

  .cover {
    display: block;
    width: 100%;
    border-radius: 8px;
    border: 1px solid var(--border);
    margin-bottom: 2.25rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--fg);
    text-decoration: none;
    font-weight: 550;
    line-height: 1.4;
  }

  .pager a:hover {
    color: var(--accent);
  }

  .pager .next {
    text-align: right;
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      text-align: left;
    }
  }

  .toc {
    display: none;
  }

  @media (min-width: 72rem) {
    .toc {
      display: block;
      position: sticky;
      top: 1.5rem;
      align-self: start;
      margin-top: 3.75rem;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
      font-size: 0.85rem;
      line-height: 1.45;
    }

    .toc ol {
      list-style: none;
      margin: 0;
      padding: 0 0 0 0.75rem;
      border-left: 1px solid var(--border);
    }

    .toc li {
      margin: 0.45rem 0;
    }

    .toc li.d3 {
      padding-left: 0.85rem;
    }

    .toc a {
      color: var(--muted);
      text-decoration: none;
    }

    .toc a:hover {
      color: var(--fg);
    }
  }
</style>
