---
import Base from "../layouts/Base.astro";
import { formatDate, getNotes, noteURL } from "../lib/posts";

const notes = await getNotes();

// The list shows a short excerpt and the first image; the full note is one click away.
function excerpt(body = ""): string {
  const para = body
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/[*_`#>]/g, "")
    .split(/\n\s*\n/)
    .map((p) => p.replace(/\s+/g, " ").trim())
    .find((p) => p.length > 0) ?? "";
  return para.length > 220 ? para.slice(0, 220).replace(/\s+\S*$/, "") + "…" : para;
}

function firstImage(body = ""): string | undefined {
  return body.match(/!\[[^\]]*\]\(([^)\s]+)/)?.[1];
}
---

<Base title="Notes" description="Short posts, mostly from LinkedIn and Facebook, kept here so they stay findable.">
  <div class="wrap">
    <header class="page-head">
      <h1>Notes</h1>
      <p class="meta">
        Short posts, mostly first shared on LinkedIn and Facebook, kept here so they stay findable. Longer pieces are under{" "}
        <a href="/archives.html">Writing</a>.
      </p>
    </header>

    <ul class="note-list">
      {
        notes.map((note) => {
          const img = firstImage(note.body);
          return (
            <li>
              <a class="item" href={noteURL(note.id)}>
                <div class="text">
                  <p class="meta">
                    <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
                    {note.data.source && <span> · {note.data.source}</span>}
                  </p>
                  <h2>{note.data.title}</h2>
                  <p class="excerpt">{excerpt(note.body)}</p>
                </div>
                {img && <img class="thumb" src={img} alt="" loading="lazy" />}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</Base>

<style>
  .page-head {
    padding-top: 3.5rem;
    margin-bottom: 1rem;
  }

  .page-head h1 {
    font-size: 2rem;
    letter-spacing: -0.02em;
    margin: 0 0 0.25rem;
  }

  .page-head .meta {
    margin: 0;
  }

  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .note-list li {
    border-bottom: 1px solid var(--border);
  }

  .note-list li:last-child {
    border-bottom: 0;
  }

  .item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.25rem 0;
    color: inherit;
    text-decoration: none;
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  .item .meta {
    margin: 0 0 0.25rem;
  }

  .item h2 {
    font-size: 1.15rem;
    line-height: 1.35;
    margin: 0 0 0.35rem;
  }

  .item:hover h2 {
    color: var(--accent);
  }

  .excerpt {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .thumb {
    flex: none;
    width: 7.5rem;
    height: 5rem;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--border);
  }

  @media (max-width: 560px) {
    .thumb {
      width: 4.5rem;
      height: 4.5rem;
    }
  }
</style>
