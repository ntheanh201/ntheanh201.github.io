---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <div class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>This page doesn't exist.</h1>
    <p>It may have moved when the blog left Notion. Try <a href="/archives.html">the full list of posts</a>.</p>
  </div>
</Base>

<style>
  .nf {
    padding-top: 5rem;
  }

  h1 {
    font-size: 2rem;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
</style>
