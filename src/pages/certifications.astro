---
import Base from "../layouts/Base.astro";
import { ALL_BADGES, CERTIFICATIONS, COMMUNITY, TRAINING, type Cert } from "../site";
import { certLabel, monthYear } from "../lib/certs";

const total = CERTIFICATIONS.reduce((n, g) => n + g.items.length, 0);
const groups: { issuer: string; note?: string; items: Cert[] }[] = [
  { issuer: "Community", items: COMMUNITY },
  ...CERTIFICATIONS,
];
---

<Base title="Certifications" description={`${total} certifications across NVIDIA, Anthropic, the Linux Foundation, CNCF and more.`}>
  <div class="wrap">
    <header class="page-head">
      <h1>Certifications</h1>
      <p class="meta">{total} certifications and {COMMUNITY.length} community recognitions. Each badge links to its verification page.</p>
    </header>

    <ul class="wall">
      {
        ALL_BADGES.map((b) => (
          <li>
            <a href={b.href} title={certLabel(b)}>
              <img src={b.img} alt={certLabel(b)} width="120" height="120" loading="lazy" />
            </a>
          </li>
        ))
      }
    </ul>

    {
      groups.map((group) => (
        <section class="group">
          <h2>{group.issuer}</h2>
          {group.note && <p class="meta note">{group.note}</p>}
          <ul class="cert-list">
            {group.items.map((c) => (
              <li>
                <span class="thumb" aria-hidden="true">
                  {c.img && <img src={c.img} alt="" width="40" height="40" loading="lazy" />}
                </span>
                <span class="name">
                  {c.name}
                  {c.short && <span class="short">{c.short}</span>}
                </span>
                <span class="when">
                  <time datetime={c.issued}>{monthYear(c.issued)}</time>
                  {c.href && (
                    <a href={c.href} aria-label={`Verify ${c.name}`}>
                      Verify ↗
                    </a>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="group">
      <h2>Training and scholarships</h2>
      <ul class="cert-list">
        {
          TRAINING.map((c) => (
            <li>
              <span class="thumb" aria-hidden="true" />
              <span class="name">{c.name}</span>
              <span class="when">
                <time datetime={c.issued}>{monthYear(c.issued)}</time>
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .page-head {
    padding-top: 3.5rem;
    margin-bottom: 2rem;
  }

  .page-head h1 {
    font-size: 2rem;
    letter-spacing: -0.02em;
    margin: 0 0 0.25rem;
  }

  .page-head .meta {
    margin: 0;
  }

  .wall {
    list-style: none;
    margin: 0 0 1rem;
    padding: 1.25rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
    gap: 1rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .wall a {
    display: block;
    transition: transform 0.15s;
  }

  .wall a:hover {
    transform: translateY(-3px);
  }

  .wall img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .group {
    margin-top: 2.75rem;
  }

  .group h2 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .note {
    margin: 0.5rem 0 0;
  }

  .cert-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cert-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: 0.25rem 0.9rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }

  .thumb img {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }

  .name {
    font-weight: 500;
    line-height: 1.45;
  }

  .short {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--faint);
  }

  .when {
    display: flex;
    gap: 0.9rem;
    font-size: 0.85rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .when a {
    color: var(--muted);
    text-decoration: none;
  }

  .when a:hover {
    color: var(--accent);
  }

  @media (max-width: 38rem) {
    .cert-list li {
      grid-template-columns: 2.5rem 1fr;
    }

    .when {
      grid-column: 2;
      white-space: normal;
      flex-wrap: wrap;
    }
  }
</style>
